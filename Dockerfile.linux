FROM ubuntu:24.04

ARG RUNNER_VERSION=2.337.0
ARG RUNNER_SHA256=70920811a4f8ad4328818682bca5c6469c1c942fab52448868071d0063816613

ENV RUNNER_URL="" \
    RUNNER_NAME="" \
    HOME=/home/runner

RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl git gzip tar unzip \
    && useradd --create-home --shell /bin/bash runner \
    && mkdir -p /home/runner/actions-runner \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /home/runner/actions-runner

RUN curl --fail --location --retry 3 \
        "https://github.com/actions/runner/releases/download/v${RUNNER_VERSION}/actions-runner-linux-x64-${RUNNER_VERSION}.tar.gz" \
        --output runner.tar.gz \
    && printf '%s  runner.tar.gz\n' "${RUNNER_SHA256}" | sha256sum --check - \
    && tar -xzf runner.tar.gz \
    && rm runner.tar.gz \
    && ./bin/installdependencies.sh \
    && rm -rf /var/lib/apt/lists/* \
    && chown -R runner:runner /home/runner/actions-runner

USER runner

CMD ["bash", "-c", "set -euo pipefail; : \"${RUNNER_URL:?Set RUNNER_URL to the GitHub organization or repository URL}\"; : \"${RUNNER_TOKEN:?Set RUNNER_TOKEN to a GitHub runner registration token}\"; : \"${RUNNER_NAME:?Set RUNNER_NAME to the runner name and runs-on label}\"; if [[ ! -f .runner ]]; then ./config.sh --unattended --url \"$RUNNER_URL\" --token \"$RUNNER_TOKEN\" --name \"$RUNNER_NAME\" --labels \"$RUNNER_NAME\" --work _work --replace; fi; unset RUNNER_TOKEN; exec ./run.sh"]